{
  "name": "ons-api-poc",
  "homepage": "http://ons-api-poc.vercel.app",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
    "build": "vite build",
    "package": "vite package",
    "preview": "vite preview",
    "lint": "prettier --check --plugin-search-dir=. .",
    "format": "prettier --write --plugin-search-dir=. .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "data:download": "tsx ./scripts/download-data.ts",
    "data:generate": "tsx ./scripts/generate-data.ts",
    "data:geo": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/make-geo-data.ts",
    "data:clusters": "tsx ./scripts/make-clusters.ts",
    "data:redirects": "tsx ./scripts/make-redirects.ts"
  },
  "author": "Office for National Statistics",
  "license": "MIT",
  "devDependencies": {
    "@mapbox/tilebelt": "^2.0.2",
    "@onsvisual/robo-utils": "^0.3.9",
    "@onsvisual/svelte-components": "^1.0.52",
    "@onsvisual/svelte-maps": "^1.2.28",
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/adapter-node": "^5.3.3",
    "@sveltejs/adapter-vercel": "^6.3.0",
    "@sveltejs/kit": "^2.46.5",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@turf/bbox": "^7.3.1",
    "@turf/bbox-polygon": "^7.3.1",
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/meta": "^7.2.0",
    "accurate-beeswarm-plot": "^1.0.12",
    "arquero": "^8.0.3",
    "cross-env": "^7.0.3",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "exceljs": "^4.4.0",
    "parse-color": "^1.0.0",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "simple-statistics": "^7.8.8",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "temporal-polyfill": "^0.3.0",
    "throttleit": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.4"
  },
  "dependencies": {
    "sirv-cli": "^1.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.6.1"
  },
  "type": "module"
}