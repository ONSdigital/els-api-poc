{
  "name": "@onsvisual/sveltekit-starter",
  "homepage": "http://onsvisual.github.io/sveltekit-starter",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS=--max-old-space-size=8192 vite dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
    "package": "vite package",
    "preview": "vite preview",
    "lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
    "format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "data:download": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/download-data.ts",
    "data:generate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/generate-data.ts",
    "data:geo": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/make-geo-data.ts",
    "data:clusters": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/make-clusters.ts"
  },
  "author": "Ahmad Barclay",
  "license": "MIT",
  "devDependencies": {
    "@mapbox/tilebelt": "^2.0.2",
    "@onsvisual/accessible-spreadsheet-creator": "^0.1.2",
    "@onsvisual/robo-utils": "^0.3.9",
    "@onsvisual/svelte-components": "^1.0.45",
    "@onsvisual/svelte-maps": "^1.2.28",
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/adapter-node": "^5.3.3",
    "@sveltejs/kit": "^2.46.5",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@turf/bbox": "^7.3.1",
    "@turf/bbox-polygon": "^7.3.1",
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/meta": "^7.2.0",
    "accurate-beeswarm-plot": "^1.0.12",
    "arquero": "^8.0.3",
    "cross-env": "^7.0.3",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "jszip": "^3.10.1",
    "parse-color": "^1.0.0",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "simple-statistics": "^7.8.8",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "svelteplot": "^0.7.0",
    "temporal-polyfill": "^0.3.0",
    "throttleit": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.4"
  },
  "dependencies": {
    "sirv-cli": "^1.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.6.1"
  },
  "type": "module"
}
